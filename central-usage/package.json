{
  "name": "central-usage",
  "productName": "Central Usage",
  "version": "2.0.0",
  "description": "Lighting (DMX + MIDI), the tracks mixer, in-ear mixes, slides, chord charts, lyrics and the instrument - the companion of Central Control. A native desktop app.",
  "main": "main.js",
  "author": {
    "name": "Central Control",
    "email": "central-control@localhost"
  },
  "license": "MIT",
  "scripts": {
    "prestart": "bash prepare-shared.sh",
    "start": "electron .",
    "predist": "bash prepare-shared.sh",
    "dist": "electron-builder --linux deb AppImage",
    "dist:all": "electron-builder --linux deb AppImage --x64 --arm64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "org.centralcontrol.usage",
    "productName": "Central Usage",
    "artifactName": "central-usage-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "preload-output.js",
      "dmx.js",
      "updater.js",
      "services.js",
      "engine.js",
      "host.js",
      "piaudio.js",
      "recorder.js",
      "app/**/*",
      "build/icon.png"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "synopsis": "Lights, mixing, in-ears, slides, charts and lyrics with Central Control",
      "desktop": {
        "Name": "Central Usage",
        "Comment": "Lights, the tracks mixer, in-ear mixes, slides, charts and lyrics with Central Control",
        "Categories": "AudioVideo;Audio;Music;"
      },
      "maintainer": "Central Control <central-control@localhost>"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2"
      ],
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh",
      "recommends": [
        "pipewire-jack",
        "python3",
        "fluidsynth"
      ]
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": null,
    "extraResources": [
      {
        "from": "native/build/cu-mixer",
        "to": "native/cu-mixer"
      },
      {
        "from": "native/build/cu-ndi",
        "to": "native/cu-ndi"
      },
      {
        "from": "native/cu-instrument.py",
        "to": "native/cu-instrument.py"
      },
      {
        "from": "native/instrument_host.py",
        "to": "native/instrument_host.py"
      },
      {
        "from": "native/instrument-plugins.json",
        "to": "native/instrument-plugins.json"
      }
    ]
  },
  "homepage": "http://padpedal.local:8080/",
  "dependencies": {
    "ws": "8.18.0"
  }
}
