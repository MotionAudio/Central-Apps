{
  "name": "central-usage",
  "productName": "Central Usage",
  "version": "2.1.0",
  "description": "Lighting (DMX + MIDI), the tracks mixer, in-ear mixes, slides, chord charts, lyrics and the instrument - the companion of Central Control. A native desktop app.",
  "main": "main.js",
  "author": {
    "name": "Central Control",
    "email": "central-control@localhost"
  },
  "license": "MIT",
  "scripts": {
    "prestart": "bash prepare-shared.sh",
    "start": "electron .",
    "predist": "bash prepare-shared.sh",
    "dist": "electron-builder --linux deb AppImage",
    "dist:all": "electron-builder --linux deb AppImage --x64 --arm64",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "org.centralcontrol.usage",
    "productName": "Central Usage",
    "artifactName": "central-usage-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "preload-output.js",
      "dmx.js",
      "updater.js",
      "services.js",
      "engine.js",
      "host.js",
      "piaudio.js",
      "recorder.js",
      "video-service.js",
      "video-cert.js",
      "preload-video.js",
      "app/**/*",
      "build/icon.png",
      "asr.js",
      "!**/node_modules/onnxruntime-node/bin/napi-v3/*/*/libonnxruntime_providers_{cuda,tensorrt}.so"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "synopsis": "Lights, mixing, in-ears, slides, charts and lyrics with Central Control",
      "desktop": {
        "Name": "Central Usage",
        "Comment": "Lights, the tracks mixer, in-ear mixes, slides, charts and lyrics with Central Control",
        "Categories": "AudioVideo;Audio;Music;"
      },
      "maintainer": "Central Control <central-control@localhost>",
      "artifactName": "central-usage-${version}-${arch}.${ext}",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/win32/**"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2"
      ],
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh",
      "recommends": [
        "pipewire-jack",
        "python3",
        "fluidsynth"
      ]
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "central-usage-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Central Usage records the audio interface's inputs for the mixer, the in-ears and the instrument. The stream's sound comes from your audio interface or Dante.",
        "NSLocalNetworkUsageDescription": "Central Usage talks to the Central Control and to the other Central Usage computers on this network.",
        "NSCameraUsageDescription": "Central Usage shows your cameras and capture cards in the Video switcher."
      },
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v3/linux/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/win32/**"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "central-usage-${version}-win-x64.${ext}",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/linux/**"
      ]
    },
    "publish": null,
    "extraResources": [
      {
        "from": "native/build",
        "to": "native",
        "filter": [
          "cu-mixer",
          "cu-mixer.exe",
          "cu-ndi",
          "cu-ndi.exe",
          "cu-rig",
          "cu-rig.exe",
          "rig-map.json",
          "cu-video",
          "cu-video.exe",
          "ffmpeg",
          "ffmpeg.exe",
          "LICENSE.ffmpeg.txt"
        ]
      },
      {
        "from": "native/cu-instrument.py",
        "to": "native/cu-instrument.py"
      },
      {
        "from": "native/instrument_host.py",
        "to": "native/instrument_host.py"
      },
      {
        "from": "native/instrument-plugins.json",
        "to": "native/instrument-plugins.json"
      },
      {
        "from": "native/sounds",
        "to": "sounds",
        "filter": [
          "*.sf2",
          "*.txt"
        ]
      }
    ],
    "afterPack": "build/after-pack.js",
    "dmg": {
      "artifactName": "central-usage-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "central-usage-${version}-win-x64.${ext}",
      "shortcutName": "Central Usage"
    },
    "asarUnpack": [
      "**/node_modules/@img/**",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/sharp/**"
    ]
  },
  "homepage": "http://padpedal.local:8080/",
  "dependencies": {
    "ws": "8.18.0",
    "@huggingface/transformers": "3.8.1"
  }
}
