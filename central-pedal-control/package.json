{
  "name": "central-pedal-control",
  "productName": "Central Pedal Control",
  "version": "9.1.4",
  "description": "Central Pedal Control: the Central Pedal app on your computer, tablet or phone - set up songs, tracks, pads, controls and the instrument, then upload them to the Central Pedal.",
  "homepage": "https://motionaudio.github.io/Central-Apps/",
  "main": "main.js",
  "author": {
    "name": "MotionAudio",
    "email": "central-control@localhost"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux deb AppImage --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "org.centralcontrol.pedalcontrol",
    "productName": "Central Pedal Control",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "src",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "driver-dist",
        "to": "driver",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": null,
    "afterPack": "build/after-pack.js",
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "central-pedal-control-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Central Pedal Control listens to your audio interface for the tuner and the instrument.",
        "NSLocalNetworkUsageDescription": "Central Pedal Control uploads songs and settings to the Central Pedal on this network.",
        "CFBundleDisplayName": "Central Pedal Control",
        "CFBundleName": "Central Pedal Control"
      }
    },
    "dmg": {
      "artifactName": "central-pedal-control-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "central-pedal-control-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "central-pedal-control-${version}-win-x64.${ext}",
      "shortcutName": "Central Pedal Control",
      "uninstallDisplayName": "Central Pedal Control"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "synopsis": "Get your Central Pedal ready anywhere, then upload it",
      "desktop": {
        "Name": "Central Pedal Control",
        "Comment": "Set up songs, tracks, pads and controls, then upload them to the Central Pedal",
        "Categories": "AudioVideo;Audio;Music;"
      },
      "maintainer": "Central Control <central-control@localhost>",
      "artifactName": "central-pedal-control-${version}-${arch}.${ext}",
      "executableName": "central-pedal-control"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2"
      ],
      "recommends": [
        "ffmpeg",
        "pipewire-jack"
      ],
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh"
    }
  }
}
