#!/bin/bash
# Central Pedal - a start-up report on the SD card's boot partition (central-pedal-log.txt), readable on any
# computer: put the card in a PC or Mac and open the "bootfs" drive. Written 1 and 4 minutes after each start, so
# when the screens or the setup Wi-Fi don't come up, the reason is there without typing any commands.
BOOT=/boot/firmware; [ -d "$BOOT" ] && [ -f "$BOOT/config.txt" ] || BOOT=/boot
mount -o remount,rw "$BOOT" 2>/dev/null || true
OUT="$BOOT/central-pedal-log.txt"
KU="$(cat /etc/pad-pedal/kiosk-user 2>/dev/null || echo pi)"; KH="$(getent passwd "$KU" | cut -d: -f6)"
{
  echo "Central Pedal start-up report - $(date)"
  echo "version: $(cat /etc/pad-pedal/version 2>/dev/null || echo unknown) · up $(cut -d' ' -f1 /proc/uptime)s · $(tr -d '\0' < /proc/device-tree/model 2>/dev/null)"
  echo "first start done: $([ -e /var/lib/pad-pedal/firstboot-done ] && echo yes || echo NO)"
  echo "power: $(vcgencmd get_throttled 2>/dev/null || echo unknown)  (0x0 = fine; 0x50005 or any 1 in the last digit = the power supply is too weak)"
  echo; echo "== start-up time"; systemd-analyze 2>&1 | head -3; systemd-analyze blame --no-pager 2>&1 | head -15
  echo; echo "== services that failed"; systemctl --failed --no-pager --no-legend 2>&1
  echo; echo "== first start (data partition, Wi-Fi radio, safe mode)"; journalctl -b -u pad-pedal-firstboot --no-pager 2>&1 | tail -40
  echo; echo "== Central Pedal (driver)"; systemctl status pad-pedal-driver --no-pager 2>&1 | head -12; journalctl -b -u pad-pedal-driver --no-pager 2>&1 | tail -80
  echo; echo "== screens (the login on the main screen starts them)"; systemctl status getty@tty1 --no-pager 2>&1 | head -8
  echo "-- session log"; tail -60 /tmp/pad-pedal-x.log 2>&1
  echo "-- Xorg"; tail -50 "$KH/.local/share/xorg/Xorg.0.log" 2>/dev/null || tail -50 /var/log/Xorg.0.log 2>&1
  echo; echo "== network"; nmcli -t -f DEVICE,TYPE,STATE,CONNECTION dev 2>&1; nmcli -t connection show 2>&1; ip -br addr 2>&1
  echo; echo "== disks"; lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT 2>&1; df -h / /data 2>&1; findmnt /data 2>&1
  echo; echo "== screens the kernel sees"; ls /sys/class/graphics/ 2>&1; for f in /sys/class/drm/card*-*/status; do echo "$f: $(cat "$f")"; done 2>/dev/null; grep -E '^(dtoverlay|dtparam)' "$BOOT/config.txt" 2>&1
  echo; echo "== 3.5\" touch (readings a second, how far a still finger wanders in px, tap delay, calibration)"
  awk 'BEGIN { RS = "" } /ADS7846|XPT2046|[Tt]ouch/' /proc/bus/input/devices 2>&1 | grep -E '^(N|H|B: ABS)' ; cat /tmp/central-pedal-touch.json 2>/dev/null || echo "(not touched since the start)"; echo
  echo; echo "== sound (cards, levels, the combined output the app plays into)"
  cat /proc/asound/cards 2>&1; aplay -l 2>&1 | grep -E "^card"
  for c in $(sed -nE 's/^ *([0-9]+) \[.*/\1/p' /proc/asound/cards 2>/dev/null); do echo "-- mixer card $c"; amixer -c "$c" 2>&1 | grep -E "Simple mixer|Playback|Mono:|Front" | head -8; done
  KUID="$(id -u "$KU" 2>/dev/null)"
  if [ -n "$KUID" ]; then
    PW=(runuser -u "$KU" -- env XDG_RUNTIME_DIR="/run/user/$KUID")
    echo "-- PipeWire"; "${PW[@]}" systemctl --user is-active pipewire.service pipewire-pulse.service wireplumber.service 2>&1 | paste -sd' '
    echo "-- sinks (default: $("${PW[@]}" pactl get-default-sink 2>&1))"; "${PW[@]}" pactl list short sinks 2>&1
    "${PW[@]}" pactl list sinks 2>&1 | grep -E "^Sink|Name:|Mute:|^\s+Volume:|Channel Map:" | head -40
    echo "-- playing now"; "${PW[@]}" pactl list short sink-inputs 2>&1
    echo "-- links"; "${PW[@]}" pw-link -l 2>&1 | head -40
  fi
  echo "-- generated config"; cat "$KH/.config/pipewire/pipewire.conf.d/padpedal.conf" 2>&1; cat /data/pad-pedal/audio-channels.json /data/pad-pedal/audio.json 2>&1; echo
  echo "-- audio set-up at login"; grep -hE "^audio" /tmp/pad-pedal-session.log /tmp/pad-pedal-x.log 2>/dev/null | tail -6
  echo; echo "== kernel messages (errors, screen, touch, sound)"; dmesg 2>&1 | grep -iE "error|fail|fbtft|fb1|spi|ads7846|under-voltage|snd|bcm2835|hifiberry|pcm5102" | tail -60
} > "$OUT.tmp" 2>&1
mv -f "$OUT.tmp" "$OUT"; sync
