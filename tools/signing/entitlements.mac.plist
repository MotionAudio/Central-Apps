<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Motion Audio Central apps on macOS with the hardened runtime (signed and notarized builds only; tools/signing-config.js).
     JIT and unsigned executable memory: Electron's JavaScript engine and the WebAssembly plugin engine.
     Library validation off: the plugin host (cu-rig, cm-plugbridge) loads VST3, CLAP and Audio Units plugins signed by
     other companies. Audio input: the audio interface, the tuner, recording. Camera: the Video tab's cameras and capture cards. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <key>com.apple.security.device.audio-input</key><true/>
  <key>com.apple.security.device.camera</key><true/>
</dict>
</plist>
