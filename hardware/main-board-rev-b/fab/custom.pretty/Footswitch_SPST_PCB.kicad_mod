(footprint "Footswitch_SPST_PCB" (version 20211014) (generator pcbnew) (layer "F.Cu")
  (descr "SPST momentary soft-touch footswitch, PCB pins, M12x1.0 bushing. Two slotted holes on a 6.8 mm pitch accept 6.3-6.9 mm pin spacings (ST P-H-ST8105, Tayda SF13P, Taiwan Alpha SF12020F). Body 25.5 x 13 mm, 15.25 mm tall; the plate sits 15.5 mm above the board.")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -9) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "FOOTSWITCH" (at 0 9) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (fp_circle (center 0 0) (end 6.35 0) (layer "F.Fab") (width 0.1) (fill none))
  (fp_rect (start -12.75 -6.5) (end 12.75 6.5) (layer "F.Fab") (width 0.1) (fill none))
  (fp_rect (start -13 -6.75) (end 13 6.75) (layer "F.SilkS") (width 0.12) (fill none))
  (fp_rect (start -13.25 -7) (end 13.25 7) (layer "F.CrtYd") (width 0.05) (fill none))
  (pad "1" thru_hole oval (at -3.4 0) (size 2.6 4.6) (drill oval 1.3 3.3) (layers *.Cu *.Mask))
  (pad "2" thru_hole oval (at 3.4 0) (size 2.6 4.6) (drill oval 1.3 3.3) (layers *.Cu *.Mask))
)
