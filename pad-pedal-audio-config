#!/usr/bin/env python3
"""
Central Control OS - audio routing (runs at every login, before the screens start).

Makes ONE multi-channel output device for the app out of every sound card:
  headphone jack (2) + I2S DAC board (2) + USB interface (its outputs) [+ HDMI]
= one PipeWire combine-stream sink "padpedal_out" with 4, 6 or 8 channels.
The app routes its buses (tracks, pads, click + MD voice) to any channel, and the
native instrument chain is linked straight to its channel. Default cables:
  1 jack L = tracks   2 jack R = pads   3 DAC L = click + voice   4 DAC R = instrument

/data/pad-pedal/audio.json: {"hdmi": false, "usbFirst": false}   (Settings → Output device)
The channel list is written to /data/pad-pedal/audio-channels.json for the Settings tab.

  pad-pedal-audio-config apply     write the PipeWire config, restart PipeWire, set the default sink
  pad-pedal-audio-config show      print what would be used
"""
import json
import os
import re
import subprocess
import sys
import time

DATA = "/data/pad-pedal"
LAYOUTS = {2: ["FL", "FR"], 4: ["FL", "FR", "RL", "RR"], 6: ["FL", "FR", "FC", "LFE", "RL", "RR"], 8: ["FL", "FR", "FC", "LFE", "RL", "RR", "SL", "SR"]}
CARD_PATTERNS = [
    ("jack", r"alsa_output\.platform-bcm2835_audio\..*|alsa_output\..*bcm2835.*|alsa_output\..*[Hh]eadphones.*", "Headphone jack", 2),
    ("i2s", r"alsa_output\.platform-soc_sound\..*|alsa_output\..*hifiberry.*|alsa_output\..*sndrpihifiberry.*|alsa_output\.platform-.*i2s.*", "I2S DAC board", 2),
    ("usb", r"alsa_output\.usb-.*", "USB interface", None),
    ("hdmi0", r"alsa_output\.platform-fef00700\.hdmi\..*|alsa_output\..*hdmi.*0.*", "HDMI 1", 2),
    ("hdmi1", r"alsa_output\.platform-fef05700\.hdmi\..*|alsa_output\..*hdmi.*1.*", "HDMI 2", 2),
]


def settings():
    cfg = {"hdmi": False, "usbFirst": False}
    try:
        with open(os.path.join(DATA, "audio.json")) as handle:
            cfg.update(json.load(handle))
    except Exception:
        pass
    return cfg


def pw_sinks(env):
    """[(node.name, description, channels)] from PipeWire (needs it running)."""
    try:
        out = subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=10, env=env).stdout
        sinks = []
        for o in json.loads(out or "[]"):
            if o.get("type") != "PipeWire:Interface:Node":
                continue
            props = (o.get("info") or {}).get("props") or {}
            if props.get("media.class") == "Audio/Sink" and str(props.get("node.name", "")).startswith("alsa_output"):
                ch = props.get("audio.channels")
                if not ch:
                    try:
                        ch = len((o["info"].get("params") or {}).get("Format", [{}])[0].get("position") or [])
                    except Exception:
                        ch = 2
                card = "|".join(str(props.get(k) or "") for k in ("alsa.id", "alsa.card_name", "api.alsa.card.name", "device.bus"))
                sinks.append((props["node.name"], props.get("node.description") or props["node.name"], int(ch or 2), card))
        return sinks
    except Exception:
        return []


# The ALSA card behind a sink names it better than PipeWire's node name, which changes between OS versions (the Pi 4's
# jack is "platform-bcm2835_audio" on some, "platform-fe00b840.mailbox" on others): (kind, card id / name pattern)
CARD_IDS = [("usb", r"(?i)\|usb$"), ("jack", r"(?i)^(headphones|bcm2835)"), ("hdmi0", r"(?i)^vc4hdmi0?$|^vc4hdmi0"), ("hdmi1", r"(?i)^vc4hdmi1"),
            ("i2s", r"(?i)hifiberry|sndrpi|pcm510|i2s|dac")]


def kind_of(sink):
    """jack / i2s / usb / hdmi0 / hdmi1 for a PipeWire sink (name, desc, channels[, "alsa.id|card name|...|bus"]), or None."""
    name, card = sink[0], (sink[3] if len(sink) > 3 else "") or ""
    if card.strip("|"):
        cid = card.split("|")[0]
        for kind, pattern in CARD_IDS:
            if re.search(pattern, cid if kind != "usb" else card):
                return kind
        if re.search(r"(?i)headphones|bcm2835", card):
            return "jack"
        if re.search(r"(?i)hdmi", card):
            return "hdmi1" if re.search(r"hdmi.?1|HDMI 2", card) else "hdmi0"
    for kind, pattern, label, fixed in CARD_PATTERNS:
        if re.match(pattern, name):
            return kind
    return None


def plan(sinks, cfg):
    """Which card gets which channels. Returns ([(kind, node.name, desc, nchannels, positions)], positions)"""
    cards = []
    for kind, pattern, label, fixed in CARD_PATTERNS:
        for sink in sinks:
            name, desc, ch = sink[0], sink[1], sink[2]
            if kind_of(sink) == kind and not any(c[1] == name for c in cards):
                cards.append([kind, name, label if kind != "usb" else desc, min(fixed or ch, 8)])
                break
    if not cfg.get("hdmi"):
        cards = [c for c in cards if not c[0].startswith("hdmi")]
    order = ["usb", "jack", "i2s", "hdmi0", "hdmi1"] if cfg.get("usbFirst") else ["jack", "i2s", "usb", "hdmi0", "hdmi1"]
    cards.sort(key=lambda c: order.index(c[0]))
    total = sum(c[3] for c in cards)
    while total > 8 and cards:  # too many: trim the last card's channels, then drop cards
        if cards[-1][3] > 2:
            cards[-1][3] -= 2
        else:
            cards.pop()
        total = sum(c[3] for c in cards)
    size = 2 if total <= 2 else 4 if total <= 4 else 6 if total <= 6 else 8
    positions = LAYOUTS[size]
    out, i = [], 0
    for kind, name, desc, ch in cards:
        out.append((kind, name, desc, ch, positions[i:i + ch]))
        i += ch
    return out, positions


def channel_names(planned, positions):
    names = []
    for pos in positions:
        label = "unused"
        for kind, name, desc, ch, poss in planned:
            if pos in poss:
                idx = poss.index(pos)
                label = desc + " " + (["L", "R"][idx] if ch == 2 else str(idx + 1))
        names.append(label)
    return names


def config_text(planned, positions):
    rules = []
    for kind, name, desc, ch, poss in planned:
        card_pos = ["FL", "FR"] if ch == 2 else [("AUX%d" % i) for i in range(ch)]
        rules.append('      { matches = [ { media.class = "Audio/Sink" node.name = "%s" } ]\n        actions = { create-stream = { combine.audio.position = [ %s ] audio.position = [ %s ] } } }' % (name, " ".join(poss), " ".join(card_pos)))
    return """# Generated by pad-pedal-audio-config - do not edit (Settings > Output device)
context.properties = {
  default.clock.rate = 48000
  default.clock.quantum = 256
  default.clock.min-quantum = 64
  default.clock.max-quantum = 2048
}
context.modules = [
  { name = libpipewire-module-combine-stream
    args = {
      combine.mode = sink
      node.name = "padpedal_out"
      node.description = "Central Control (%(n)d channels)"
      combine.latency-compensate = false
      combine.props = { audio.position = [ %(positions)s ] priority.session = 3000 priority.driver = 3000 }
      stream.props = { }
      stream.rules = [
%(rules)s
      ]
    }
  }
]
""" % {"n": len(positions), "positions": " ".join(positions), "rules": "\n".join(rules)}


def asound_cards():
    """[(index, id)] from /proc/asound/cards, e.g. [(0, "Headphones"), (1, "vc4hdmi0"), (2, "vc4hdmi1")]."""
    cards = []
    try:
        with open("/proc/asound/cards") as handle:
            for line in handle:
                m = re.match(r"\s*(\d+)\s+\[(\S+)\s*\]", line)
                if m:
                    cards.append((int(m.group(1)), m.group(2)))
    except OSError:
        pass
    return cards


def plays(index):
    """The card has an output (a USB MIDI keyboard or a microphone is a card too, with nothing to play on)."""
    try:
        return any(n.startswith("pcm") and n.endswith("p") for n in os.listdir("/proc/asound/card%d" % index))
    except OSError:
        return True


def wanted_cards(cfg):
    """The sound cards the combined output should hold (HDMI only when Settings → Output device asks for it)."""
    return [c for c in asound_cards() if (cfg.get("hdmi") or not re.match(r"(?i)vc4hdmi|hdmi", c[1])) and plays(c[0])]


def wait_for_sinks(env, cfg, timeout=20.0):
    """PipeWire makes the cards' sinks one by one, a few seconds after login (HDMI ones often first). Wait until every
    card we want has a sink - stopping at the first two sinks used to plan with only the HDMI ones, leave the headphone
    jack out and make a combined output with nothing behind it: no sound at all."""
    want = len(wanted_cards(cfg))
    end, sinks = time.time() + timeout, []
    while True:
        sinks = pw_sinks(env)
        mine = [s for s in sinks if cfg.get("hdmi") or not (kind_of(s) in ("hdmi0", "hdmi1") or re.search(r"hdmi", s[0], re.I))]
        if (want and len(mine) >= want) or (not want and sinks) or time.time() > end:
            return sinks
        time.sleep(0.5)


def fallback_cards(sinks):
    """No known card matched: use whatever output PipeWire has (better than a combined output with nothing behind it)."""
    for sink in sorted(sinks, key=lambda s: (kind_of(s) in ("hdmi0", "hdmi1") or bool(re.search(r"hdmi", s[0], re.I)), s[0])):
        name, desc = sink[0], sink[1]
        kind = "hdmi0" if kind_of(sink) in ("hdmi0", "hdmi1") or re.search(r"hdmi", name, re.I) else "jack"
        return [(kind, name, desc, 2, ["FL", "FR"])], LAYOUTS[2]
    return [], LAYOUTS[2]


def unmute(env, planned):
    """Every card at full level and unmuted (a fresh card can come up muted or quiet); levels are set in the app."""
    for idx, cid in asound_cards():   # the jack's own mixer ("PCM") when PipeWire doesn't drive it: 0 dB, on
        if re.match(r"(?i)headphones|bcm2835", cid):
            for control in ("PCM", "Headphone"):
                subprocess.run(["amixer", "-q", "-c", str(idx), "sset", control, "0dB", "unmute"], capture_output=True, timeout=10)
    for kind, name, desc, ch, poss in planned:
        subprocess.run(["pactl", "set-sink-mute", name, "0"], env=env, capture_output=True, timeout=10)
        subprocess.run(["pactl", "set-sink-volume", name, "100%"], env=env, capture_output=True, timeout=10)
    subprocess.run(["pactl", "set-sink-mute", "padpedal_out", "0"], env=env, capture_output=True, timeout=10)
    subprocess.run(["pactl", "set-sink-volume", "padpedal_out", "100%"], env=env, capture_output=True, timeout=10)


WP_CONF = """# Generated by pad-pedal-audio-config: the app's sound always goes to the default output (the combined one).
# Remembering where a stream played last sent the app to HDMI, where nobody listens, after the combined output came back.
wireplumber.settings = {
  node.stream.restore-target = false
}
"""


def forget_stream_targets(home):
    """WirePlumber remembers the device each app last played on and sends it back there, past the default output. Turn
    that off and forget a remembered device other than the combined output. True when something changed (restart it)."""
    changed = False
    conf_dir = os.path.join(home, ".config", "wireplumber", "wireplumber.conf.d")
    os.makedirs(conf_dir, exist_ok=True)
    path = os.path.join(conf_dir, "padpedal.conf")
    try:
        old = open(path).read()
    except OSError:
        old = ""
    if old != WP_CONF:
        with open(path, "w") as handle:
            handle.write(WP_CONF)
        changed = True
    state = os.path.join(home, ".local", "state", "wireplumber")
    for name in ("stream-properties", "restore-stream"):
        f = os.path.join(state, name)
        try:
            lines = open(f).read().splitlines()
        except OSError:
            continue
        keep = [ln for ln in lines if not (re.search(r"(?i)target", ln) and re.search(r"alsa_output|bluez_output", ln))]   # (any remembered real device)
        if len(keep) != len(lines):
            with open(f, "w") as handle:
                handle.write("\n".join(keep) + "\n")
            changed = True
            print("audio: forgot a remembered output in %s" % name)
    return changed


def move_app_streams(env):
    """The app's (Chromium's) streams that started before the combined output, or were sent elsewhere, go to it. (Not the
    instrument chain's: it links its own channels.)"""
    def short(what):
        try:
            out = subprocess.run(["pactl", "list", "short", what], env=env, capture_output=True, text=True, timeout=10).stdout
        except Exception:
            return []
        return [ln.split("\t") for ln in out.splitlines() if ln.strip()]
    chrome = {c[0] for c in short("clients") if len(c) > 2 and re.search(r"(?i)chrom", c[2])}
    for si in short("sink-inputs"):
        if len(si) > 2 and si[2] in chrome:
            subprocess.run(["pactl", "move-sink-input", si[0], "padpedal_out"], env=env, capture_output=True, timeout=10)


def usb_channels(index):
    """(playback, capture) channel counts of a USB sound card, from /proc/asound/cardN/stream0 (0, 0 when not USB)."""
    try:
        text = open("/proc/asound/card%d/stream0" % index).read()
    except OSError:
        return 0, 0
    out = {"Playback": 0, "Capture": 0}
    part = None
    for line in text.splitlines():
        m = re.match(r"^(Playback|Capture):", line.strip())
        if m:
            part = m.group(1)
            continue
        m = re.search(r"Channels:\s*(\d+)", line)
        if m and part:
            out[part] = max(out[part], int(m.group(1)))
    return out["Playback"], out["Capture"]


def usb_pro_audio(env):
    """A USB interface with more than two outputs or inputs: PipeWire's default profile only offers two of them. Its
    "pro-audio" profile gives every channel (outputs 5, 6, … on the pedal; every input for the instrument). True when a
    profile was changed (the sinks come back under new names)."""
    try:
        text = subprocess.run(["pactl", "list", "cards"], env=env, capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return False
    changed = False
    for block in re.split(r"\n(?=Card #)", text):
        name = re.search(r"^\s*Name:\s*(\S+)", block, re.M)
        idx = re.search(r'alsa\.card = "(\d+)"', block)
        if not name or not idx or "pro-audio" not in block or not name.group(1).startswith("alsa_card.usb-"):
            continue
        play, cap = usb_channels(int(idx.group(1)))
        active = re.search(r"Active Profile:\s*(\S+)", block)
        if max(play, cap) > 2 and not (active and active.group(1) == "pro-audio"):
            r = subprocess.run(["pactl", "set-card-profile", name.group(1), "pro-audio"], env=env, capture_output=True, timeout=10)
            print("audio: %s has %d outputs / %d inputs - every channel on (pro-audio)%s" % (name.group(1), play, cap, "" if r.returncode == 0 else " FAILED"))
            changed = changed or r.returncode == 0
    return changed


def apply():
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    cfg = settings()
    wait_for_sinks(env, cfg, timeout=8.0)
    if usb_pro_audio(env):
        time.sleep(1.0)
    sinks = wait_for_sinks(env, cfg)
    print("audio: cards %s · sinks %s" % ([c[1] for c in asound_cards()], [s[0] for s in sinks]))
    planned, positions = plan(sinks, cfg)
    if not planned:
        planned, positions = fallback_cards(sinks)
        print("audio: no known sound card among %s - using %s" % ([s[0] for s in sinks], [p[1] for p in planned] or "nothing"))
    home = os.path.expanduser("~")
    target = os.path.join(home, ".config", "pipewire", "pipewire.conf.d")
    os.makedirs(target, exist_ok=True)
    path = os.path.join(target, "padpedal.conf")
    text = config_text(planned, positions)
    old = ""
    try:
        with open(path) as handle:
            old = handle.read()
    except OSError:
        pass
    with open(path, "w") as handle:
        handle.write(text)
    os.makedirs(DATA, exist_ok=True)
    with open(os.path.join(DATA, "audio-channels.json"), "w") as handle:
        json.dump({"channels": channel_names(planned, positions), "cards": [{"kind": p[0], "name": p[1], "desc": p[2], "channels": p[3]} for p in planned]}, handle)
    if forget_stream_targets(home) or old != text:
        subprocess.run(["systemctl", "--user", "restart", "pipewire.service", "pipewire-pulse.service", "wireplumber.service"], env=env, timeout=30)
    for _ in range(30):
        result = subprocess.run(["pactl", "set-default-sink", "padpedal_out"], env=env, capture_output=True, text=True)
        if result.returncode == 0:
            break
        time.sleep(0.5)
    unmute(env, planned)
    move_app_streams(env)
    print("audio: %d channels: %s" % (len(positions), ", ".join("%d %s" % (i + 1, n) for i, n in enumerate(channel_names(planned, positions)))))


if __name__ == "__main__":
    if sys.argv[1:2] == ["apply"]:
        apply()
    else:
        env = dict(os.environ)
        env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
        sinks = pw_sinks(env)
        planned, positions = plan(sinks, settings())
        print("sinks:", sinks)
        print("channels:", channel_names(planned, positions))
        print(config_text(planned, positions))
