{
 "format": "central-fx",
 "version": 1,
 "id": "uni-vibe",
 "name": "Uni-Vibe",
 "author": "Motion Audio",
 "family": "modulation",
 "tier": "plugins",
 "description": "The swirling, throbbing chorus-phaser of 60s and 70s guitar - also lovely on organ and electric piano.",
 "params": [
  {
   "id": "rate",
   "name": "Speed",
   "min": 0.2,
   "max": 10,
   "default": 1.5,
   "unit": "Hz",
   "curve": "log"
  },
  {
   "id": "intensity",
   "name": "Intensity",
   "min": 0,
   "max": 1,
   "default": 0.75
  },
  {
   "id": "mix",
   "name": "Mix",
   "min": 0,
   "max": 1,
   "default": 0.55
  }
 ],
 "presets": [
  {
   "name": "Slow swirl",
   "values": {
    "rate": 1,
    "intensity": 0.7
   }
  },
  {
   "name": "Throb",
   "values": {
    "rate": 5,
    "intensity": 0.9,
    "mix": 0.6
   }
  },
  {
   "name": "Organ",
   "values": {
    "rate": 2.5,
    "intensity": 0.6,
    "mix": 0.5
   }
  }
 ],
 "graph": {
  "blocks": [
   {
    "id": "in",
    "type": "input",
    "x": 40,
    "y": 40,
    "props": {}
   },
   {
    "id": "ph",
    "type": "phaser",
    "x": 240,
    "y": 40,
    "props": {
     "rate": {
      "param": "rate"
     },
     "depth": {
      "param": "intensity"
     },
     "feedback": 0.15,
     "mix": {
      "param": "mix"
     }
    }
   },
   {
    "id": "wob",
    "type": "chorus",
    "x": 440,
    "y": 40,
    "props": {
     "rate": {
      "param": "rate"
     },
     "depth": 0.2,
     "mix": 0.3
    }
   },
   {
    "id": "warm",
    "type": "eq",
    "x": 640,
    "y": 40,
    "props": {
     "mode": "highshelf",
     "freq": 6000,
     "q": 0.7,
     "gain": -2
    }
   },
   {
    "id": "lvl",
    "type": "gain",
    "x": 840,
    "y": 40,
    "props": {
     "gain": 4.5
    }
   },
   {
    "id": "out",
    "type": "output",
    "x": 1040,
    "y": 40,
    "props": {}
   }
  ],
  "wires": [
   {
    "from": "in.out",
    "to": "ph.in"
   },
   {
    "from": "ph.out",
    "to": "wob.in"
   },
   {
    "from": "wob.out",
    "to": "warm.in"
   },
   {
    "from": "warm.out",
    "to": "lvl.in"
   },
   {
    "from": "lvl.out",
    "to": "out.in"
   }
  ]
 }
}
