{
 "format": "central-fx",
 "version": 1,
 "id": "flanger",
 "name": "Flanger",
 "author": "Motion Audio",
 "family": "modulation",
 "tier": "plugins",
 "description": "The jet-plane sweep: a very short moving delay with feedback.",
 "params": [
  {
   "id": "rate",
   "name": "Speed",
   "min": 0.05,
   "max": 4,
   "default": 0.25,
   "unit": "Hz",
   "curve": "log"
  },
  {
   "id": "depth",
   "name": "Depth",
   "min": 0,
   "max": 1,
   "default": 0.7
  },
  {
   "id": "feedback",
   "name": "Feedback",
   "min": -0.9,
   "max": 0.9,
   "default": 0.6
  },
  {
   "id": "mix",
   "name": "Mix",
   "min": 0,
   "max": 1,
   "default": 0.5
  }
 ],
 "presets": [
  {
   "name": "Jet",
   "values": {
    "rate": 0.15,
    "depth": 0.9,
    "feedback": 0.75
   }
  },
  {
   "name": "Gentle",
   "values": {
    "rate": 0.3,
    "depth": 0.4,
    "feedback": 0.3,
    "mix": 0.35
   }
  },
  {
   "name": "Metallic",
   "values": {
    "rate": 0.5,
    "depth": 0.6,
    "feedback": -0.8
   }
  }
 ],
 "graph": {
  "blocks": [
   {
    "id": "in",
    "type": "input",
    "x": 40,
    "y": 40,
    "props": {}
   },
   {
    "id": "fl",
    "type": "chorus",
    "x": 240,
    "y": 40,
    "props": {
     "mode": "flanger",
     "rate": {
      "param": "rate"
     },
     "depth": {
      "param": "depth"
     },
     "feedback": {
      "param": "feedback"
     },
     "mix": {
      "param": "mix"
     }
    }
   },
   {
    "id": "out",
    "type": "output",
    "x": 440,
    "y": 40,
    "props": {}
   }
  ],
  "wires": [
   {
    "from": "in.out",
    "to": "fl.in"
   },
   {
    "from": "fl.out",
    "to": "out.in"
   }
  ]
 }
}
