{
 "format": "central-fx",
 "version": 1,
 "id": "bitcrusher",
 "name": "Bitcrusher",
 "author": "Motion Audio",
 "family": "saturation",
 "tier": "free",
 "description": "Fewer bits and a lower sample rate: from vintage sampler grit to all-out digital destruction.",
 "params": [
  {
   "id": "bits",
   "name": "Bits",
   "min": 2,
   "max": 16,
   "default": 8
  },
  {
   "id": "rate",
   "name": "Sample rate",
   "min": 1000,
   "max": 44100,
   "default": 11025,
   "unit": "Hz",
   "curve": "log"
  },
  {
   "id": "mix",
   "name": "Mix",
   "min": 0,
   "max": 1,
   "default": 1
  }
 ],
 "presets": [
  {
   "name": "SP-1200",
   "values": {
    "bits": 12,
    "rate": 26000
   }
  },
  {
   "name": "8-bit",
   "values": {
    "bits": 8,
    "rate": 11025
   }
  },
  {
   "name": "Destroyed",
   "values": {
    "bits": 4,
    "rate": 3000,
    "mix": 0.7
   }
  }
 ],
 "graph": {
  "blocks": [
   {
    "id": "in",
    "type": "input",
    "x": 40,
    "y": 40,
    "props": {}
   },
   {
    "id": "bc",
    "type": "bitcrush",
    "x": 240,
    "y": 40,
    "props": {
     "bits": {
      "param": "bits"
     },
     "rate": {
      "param": "rate"
     },
     "mix": {
      "param": "mix"
     }
    }
   },
   {
    "id": "out",
    "type": "output",
    "x": 440,
    "y": 40,
    "props": {}
   }
  ],
  "wires": [
   {
    "from": "in.out",
    "to": "bc.in"
   },
   {
    "from": "bc.out",
    "to": "out.in"
   }
  ]
 }
}
