{
 "format": "central-fx",
 "version": 1,
 "id": "bus-glue",
 "name": "Bus Glue",
 "author": "Motion Audio",
 "family": "compressor",
 "tier": "plugins",
 "description": "The bus compressor that pulls a mix together: gentle, RMS, with a side-chain filter so the bass doesn't pump it.",
 "params": [
  {
   "id": "threshold",
   "name": "Threshold",
   "min": -40,
   "max": 0,
   "default": -18,
   "unit": "dB"
  },
  {
   "id": "ratio",
   "name": "Ratio",
   "min": 1.5,
   "max": 10,
   "default": 2,
   "unit": ":1"
  },
  {
   "id": "attack",
   "name": "Attack",
   "min": 0.1,
   "max": 30,
   "default": 10,
   "unit": "ms",
   "curve": "log"
  },
  {
   "id": "release",
   "name": "Release",
   "min": 100,
   "max": 1200,
   "default": 300,
   "unit": "ms",
   "curve": "log"
  },
  {
   "id": "makeup",
   "name": "Make-up",
   "min": 0,
   "max": 12,
   "default": 2,
   "unit": "dB"
  },
  {
   "id": "schpf",
   "name": "Side-chain HPF",
   "min": 10,
   "max": 300,
   "default": 60,
   "unit": "Hz",
   "curve": "log"
  },
  {
   "id": "mix",
   "name": "Mix",
   "min": 0,
   "max": 1,
   "default": 1
  }
 ],
 "presets": [
  {
   "name": "Mix glue",
   "values": {
    "threshold": -16,
    "ratio": 2,
    "attack": 10,
    "release": 300,
    "makeup": 2
   }
  },
  {
   "name": "Drum bus",
   "values": {
    "threshold": -20,
    "ratio": 4,
    "attack": 3,
    "release": 200,
    "makeup": 4,
    "schpf": 90
   }
  },
  {
   "name": "Gentle master",
   "values": {
    "threshold": -10,
    "ratio": 1.5,
    "attack": 30,
    "release": 600,
    "makeup": 1
   }
  },
  {
   "name": "Vocal bus",
   "values": {
    "threshold": -18,
    "ratio": 3,
    "attack": 5,
    "release": 150,
    "makeup": 3,
    "schpf": 150
   }
  }
 ],
 "graph": {
  "blocks": [
   {
    "id": "in",
    "type": "input",
    "x": 40,
    "y": 40,
    "props": {}
   },
   {
    "id": "glue",
    "type": "compressor",
    "x": 240,
    "y": 40,
    "props": {
     "style": "glue",
     "detect": "rms",
     "threshold": {
      "param": "threshold"
     },
     "ratio": {
      "param": "ratio"
     },
     "attack": {
      "param": "attack"
     },
     "release": {
      "param": "release"
     },
     "makeup": {
      "param": "makeup"
     },
     "schpf": {
      "param": "schpf"
     },
     "knee": 8,
     "mix": {
      "param": "mix"
     }
    }
   },
   {
    "id": "out",
    "type": "output",
    "x": 440,
    "y": 40,
    "props": {}
   }
  ],
  "wires": [
   {
    "from": "in.out",
    "to": "glue.in"
   },
   {
    "from": "glue.out",
    "to": "out.in"
   }
  ]
 }
}
