{
 "format": "central-fx",
 "version": 1,
 "id": "lofi-tape",
 "name": "Lo-Fi Tape",
 "author": "Motion Audio",
 "family": "saturation",
 "tier": "plugins",
 "description": "A worn cassette: wobbling pitch, a dull top and soft saturation. Instant nostalgia for keys, drums and vocals.",
 "params": [
  {
   "id": "wow",
   "name": "Wobble",
   "min": 0,
   "max": 1,
   "default": 0.4
  },
  {
   "id": "age",
   "name": "Age",
   "min": 2000,
   "max": 16000,
   "default": 6500,
   "unit": "Hz",
   "curve": "log"
  },
  {
   "id": "drive",
   "name": "Saturation",
   "min": 0,
   "max": 24,
   "default": 8,
   "unit": "dB"
  },
  {
   "id": "mix",
   "name": "Mix",
   "min": 0,
   "max": 1,
   "default": 1
  }
 ],
 "presets": [
  {
   "name": "Cassette",
   "values": {
    "wow": 0.4,
    "age": 6500
   }
  },
  {
   "name": "Old VHS",
   "values": {
    "wow": 0.7,
    "age": 4000,
    "drive": 12
   }
  },
  {
   "name": "Gentle",
   "values": {
    "wow": 0.2,
    "age": 11000,
    "drive": 4
   }
  }
 ],
 "graph": {
  "blocks": [
   {
    "id": "in",
    "type": "input",
    "x": 40,
    "y": 230,
    "props": {}
   },
   {
    "id": "wob",
    "type": "chorus",
    "x": 40,
    "y": 40,
    "props": {
     "rate": 0.6,
     "depth": {
      "param": "wow"
     },
     "mix": 1
    }
   },
   {
    "id": "tape",
    "type": "drive",
    "x": 240,
    "y": 40,
    "props": {
     "mode": "tape",
     "drive": {
      "param": "drive"
     },
     "tone": {
      "param": "age"
     },
     "level": -4,
     "mix": 1,
     "oversample": 2
    }
   },
   {
    "id": "lp",
    "type": "filter",
    "x": 440,
    "y": 40,
    "props": {
     "mode": "lowpass",
     "freq": {
      "param": "age"
     },
     "q": 0.6
    }
   },
   {
    "id": "hp",
    "type": "filter",
    "x": 640,
    "y": 40,
    "props": {
     "mode": "highpass",
     "freq": 90,
     "q": 0.6
    }
   },
   {
    "id": "blend",
    "type": "mix",
    "x": 1240,
    "y": 230,
    "props": {
     "mix": {
      "param": "mix"
     }
    }
   },
   {
    "id": "out",
    "type": "output",
    "x": 1440,
    "y": 230,
    "props": {}
   }
  ],
  "wires": [
   {
    "from": "in.out",
    "to": "wob.in"
   },
   {
    "from": "wob.out",
    "to": "tape.in"
   },
   {
    "from": "tape.out",
    "to": "lp.in"
   },
   {
    "from": "lp.out",
    "to": "hp.in"
   },
   {
    "from": "hp.out",
    "to": "blend.wet"
   },
   {
    "from": "in.out",
    "to": "blend.dry"
   },
   {
    "from": "blend.out",
    "to": "out.in"
   }
  ]
 }
}
