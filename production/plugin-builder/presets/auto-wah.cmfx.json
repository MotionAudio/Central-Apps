{
  "format": "central-fx", "version": 1, "name": "Auto-Wah", "author": "Motion Audio",
  "description": "The harder you play, the brighter it opens. Funky on clean guitar and bass.",
  "params": [
    { "id": "sense", "name": "Sensitivity", "min": -12, "max": 24, "default": 8, "unit": "dB" },
    { "id": "q", "name": "Peak", "min": 1, "max": 10, "default": 4 },
    { "id": "mix", "name": "Mix", "min": 0, "max": 1, "default": 1 }
  ],
  "graph": {
    "blocks": [
      { "id": "in", "type": "input", "x": 40, "y": 160 },
      { "id": "follow", "type": "envelope", "x": 220, "y": 40, "props": { "attack": 5, "release": 140, "sensitivity": { "param": "sense" }, "from": 350, "to": 2800 } },
      { "id": "wah", "type": "filter", "x": 420, "y": 160, "props": { "mode": "bandpass", "q": { "param": "q" } } },
      { "id": "level", "type": "gain", "x": 580, "y": 160, "props": { "gain": 4 } },
      { "id": "blend", "type": "mix", "x": 740, "y": 160, "props": { "mix": { "param": "mix" } } },
      { "id": "out", "type": "output", "x": 900, "y": 160 }
    ],
    "wires": [
      { "from": "in.out", "to": "follow.in" }, { "from": "follow.out", "to": "wah.freq" }, { "from": "in.out", "to": "wah.in" },
      { "from": "wah.out", "to": "level.in" }, { "from": "in.out", "to": "blend.dry" }, { "from": "level.out", "to": "blend.wet" }, { "from": "blend.out", "to": "out.in" }
    ]
  }
}
