# Copy to .env for running on your own PC. On Render these are set in the dashboard (render.yaml asks for them).
DATABASE_URL=postgres://localhost/motionaudio
PUBLIC_URL=http://localhost:8080
TOKEN_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=you@example.com

# Stripe (Developers → API keys, and Developers → Webhooks)
STRIPE_SECRET_KEY=sk_test_...      # or a restricted key rk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudflare R2 (R2 → Manage API tokens). Leave empty to keep files in ./data/files (testing only).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=central-tracks
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Email (Resend: resend.com → API Keys; MAIL_FROM on a domain verified in Resend). Invites, reminders, Forgot password.
RESEND_API_KEY=
MAIL_FROM=Motion Audio <team@your-domain.com>
# The time zone of the schedule emails (Central Services reminders go out from 9 a.m. the day before)
TIME_ZONE=America/Chicago

# Technical support: the Contact support form (website and apps) and the error alerts go to this address
SUPPORT_EMAIL=support@your-domain.com
# ALERT_EMAIL=you@your-domain.com      # (error alerts somewhere else than SUPPORT_EMAIL)
# Text messages for the admins' sign-in codes (twilio.com). Without them, the codes go by email.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15125550100
# REQUIRE_ID_TO_PUBLISH=on    # (publishers verify their ID once with Stripe Identity before their first upload)
