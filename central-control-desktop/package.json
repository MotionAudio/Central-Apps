{
  "name": "central-control",
  "productName": "Central Control",
  "version": "8.2.0",
  "description": "Central Pedal on a PC: worship pads, multitracks, the guitar / keys rig, click and chord charts. A native desktop app.",
  "main": "main.js",
  "author": {
    "name": "MotionAudio",
    "email": "central-control@localhost"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux deb AppImage",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "org.centralcontrol.app",
    "productName": "Central Control",
    "artifactName": "central-control-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "build/icon.png",
      "asr.js",
      "!**/node_modules/onnxruntime-node/bin/napi-v3/*/*/libonnxruntime_providers_{cuda,tensorrt}.so"
    ],
    "extraResources": [
      {
        "from": "src",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "driver-dist",
        "to": "driver",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "native",
        "to": "native",
        "filter": [
          "cu-rig",
          "cu-rig.exe",
          "rig-map.json"
        ]
      },
      {
        "from": "sounds",
        "to": "sounds",
        "filter": [
          "*.sf2",
          "*.txt"
        ]
      }
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "synopsis": "Worship pads, multitracks, guitar and keys rig, click and chord charts",
      "desktop": {
        "Name": "Central Pedal",
        "Comment": "Worship pads, multitracks, guitar and keys rig, click and chord charts",
        "Categories": "AudioVideo;Audio;Music;"
      },
      "maintainer": "Central Control <central-control@localhost>",
      "artifactName": "central-control-${version}-${arch}.${ext}",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/win32/**"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2",
        "python3",
        "python3-websockets",
        "python3-gpiozero",
        "python3-pil",
        "python3-evdev"
      ],
      "recommends": [
        "python3-mido",
        "python3-rtmidi",
        "poppler-utils",
        "espeak-ng",
        "pipewire",
        "fluidsynth",
        "fluid-soundfont-gm",
        "guitarix-ladspa",
        "caps",
        "swh-plugins",
        "tap-plugins"
      ],
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh"
    },
    "publish": null,
    "afterPack": "build/after-pack.js",
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "central-control-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Central Pedal plays your guitar and keys through the instrument rig and listens for the tuner.",
        "NSLocalNetworkUsageDescription": "Central Pedal talks to phones, tablets and Central Control computers on this network.",
        "CFBundleDisplayName": "Central Pedal",
        "CFBundleName": "Central Pedal"
      },
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v3/linux/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/win32/**"
      ]
    },
    "dmg": {
      "artifactName": "central-control-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "central-control-${version}-win-x64.${ext}",
      "files": [
        "!**/node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/linux/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "central-control-${version}-win-x64.${ext}",
      "shortcutName": "Central Pedal",
      "uninstallDisplayName": "Central Pedal"
    },
    "asarUnpack": [
      "**/node_modules/@img/**",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/sharp/**"
    ]
  },
  "homepage": "http://padpedal.local:8080/",
  "dependencies": {
    "@huggingface/transformers": "3.8.1"
  }
}
